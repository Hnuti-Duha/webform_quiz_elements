{#
/**
 * @file
 * Default theme implementation of a Webform Quiz Score element.
 *
 * Available variables:
 *  - quiz_total_questions_count
 *  - quiz_correct_answers_count
 *  - quiz_score
 *  - quiz_is_pass
 *  - quiz_feedback_message
 * @see template_preprocess_webform_quiz_elements_score()
 *
 * @ingroup themeable
 */
#}
<div class="webform-quiz-elements__score">
  <h3>Quiz result</h3>

  <div class="form-item">
    <p>You have answered<strong>{{quiz_correct_answers_count}} out of {{quiz_total_questions_count}}</strong> correctly.</p>
    <p>{{quiz_feedback_message}}</p>
  </div>
</div>
