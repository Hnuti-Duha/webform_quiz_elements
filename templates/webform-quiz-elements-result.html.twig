{#
/**
 * @file
 * Default theme implementation of a Webform Quiz result element.
 *
 * Available variables:
 * - quiz_title: HTML attributes for the horizontal_rule element.
 * - quiz_options: HTML attributes for the horizontal_rule element.
 *
 * @see template_preprocess_webform_quiz_elements_result()
 *
 * @ingroup themeable
 */
#}

<div class="webform-quiz-elements__result">
  <h4>{{quiz_title}}</h4>
  <div class="form-item">
    <ul class="webform-quiz-element-result-list">
    {% for quiz_option in quiz_options %}
      {% set quiz_option_attributes = create_attribute() %}
      {% set option_classes = [
        'alert'
      ] %}
      {% if quiz_option.is_correct %}
        {% set option_classes = [
          'alert-success'
        ]|merge(option_classes) %}
      {% endif %}
      {%  if quiz_option.is_selected and quiz_option.is_correct == false %}
        {% set option_classes = [
          'alert-danger'
        ]|merge(option_classes) %}
      {% endif %}
      <li{{ quiz_option_attributes.addClass(option_classes) }}>
        <strong>{{ quiz_option.option }}</strong>
        {% if quiz_option.is_selected %}
        <span class="sr-only">Your answer is {{ quiz_option.is_correct ? 'correct' : 'incorrect' }}</span>
        <p class="form-item">{{ quiz_option.feedback }}</p>
        {% endif %}
      </li>
      {%- endfor %}
    </ul>
  </div>
</div>

